# init --force removes a hand-edited legacy block too, cutting only the block
# and the line ending after it; the user's content around it is preserved.

env CONSTITUTION_TODAY=2026-07-02

exec constitution init
cp drifted-claude.md CLAUDE.md

exec constitution init --force
stdout '^constitution: removed the always-loaded constitution block from CLAUDE.md$'
! stderr 'edited by hand'
cmp CLAUDE.md want-claude.md

-- drifted-claude.md --
# MY CUSTOM HEADER

<!-- BEGIN adr-sourced-constitution v1 (managed — do not edit by hand; `constitution init` updates it) -->
@constitution/HACKED.md
<!-- END adr-sourced-constitution v1 -->

Trailing user note.
-- want-claude.md --
# MY CUSTOM HEADER


Trailing user note.
