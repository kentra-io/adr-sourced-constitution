# `--founding-file` seeds one founding ADR per '## ' heading: the heading is
# the ADR title, the text beneath it is the Decision Outcome. A '## Rules'
# heading immediately following a principle carries that principle's standing
# rules in the '### <category>' / '#### <slug>' grammar, making the founding
# ADR rule-bearing (its rules project into constitution.md); a principle with
# no '## Rules' is a catalog-only record (plan §2.12). Under the default
# sourceTracking.type (none) they carry no source field (plan §2.8).

env CONSTITUTION_TODAY=2026-07-02

exec constitution init --founding-file principles.md --target claude
stdout 'created .*ADR-0001-tests-are-mandatory\.md'
stdout 'created .*ADR-0002-small-focused-prs\.md'

! grep 'source:' constitution/adr/ADR-0001-tests-are-mandatory.md
grep 'Every change ships with tests, no exceptions.' constitution/adr/ADR-0001-tests-are-mandatory.md
grep 'Keep pull requests focused and small.' constitution/adr/ADR-0002-small-focused-prs.md

# ADR-0001 has a '## Rules' section -> rule-bearing -> its rule projects
# under the rule's slug heading.
grep '## Rules' constitution/adr/ADR-0001-tests-are-mandatory.md
grep '#### tests-required' constitution/adr/ADR-0001-tests-are-mandatory.md
grep 'Every change ships with tests.' constitution/constitution.md
grep '### tests-required' constitution/constitution.md
# ADR-0002 has no '## Rules' -> record-only -> stays in the log, does not project.
! grep '## Rules' constitution/adr/ADR-0002-small-focused-prs.md
! grep 'Small focused PRs' constitution/constitution.md

exec constitution guard
stdout 'clean'

-- principles.md --
## Tests are mandatory

Every change ships with tests, no exceptions.

## Rules

### testing

#### tests-required
Every change ships with tests.

## Small focused PRs

Keep pull requests focused and small.
