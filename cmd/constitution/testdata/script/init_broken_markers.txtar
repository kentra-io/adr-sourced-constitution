# A malformed marker pair (BEGIN with no END) is never guessed: init warns,
# leaves the file byte-identical, and still scaffolds and exits 0 — the
# broken block can no longer block init (0.4.0 only removes blocks), and
# even --force does not touch it.

env CONSTITUTION_TODAY=2026-07-02

cp CLAUDE.md want-claude.md
exec constitution init --force
stderr 'managed block in CLAUDE.md: BEGIN marker present without a matching END'
stderr 'leaving it untouched'
cmp CLAUDE.md want-claude.md

# scaffolded normally
exists constitution.yml
exists constitution/constitution.md

-- CLAUDE.md --
# Project

<!-- BEGIN adr-sourced-constitution v1 (managed — do not edit by hand; `constitution init` updates it) -->
@constitution/constitution.md
