# The .state self-heal must NOT become a way to silently clobber a hand-edited
# file. With a corrupt .state degraded to empty AND a drifted legacy pointer
# block in CLAUDE.md, a non-interactive re-init without --force leaves the
# block untouched (drift detection is content based, so an empty state still
# catches a drifted interior) and warns. The user's edits are preserved.

env CONSTITUTION_TODAY=2026-07-02

exec constitution init

# a drifted legacy block AND poisoned drift bookkeeping
cp drifted-claude.md CLAUDE.md
cp corrupt.state constitution/.state

exec constitution init
stderr 'empty drift state'
stderr 'edited by hand; leaving it'
cmp CLAUDE.md drifted-claude.md

-- corrupt.state --
schemaVersion: [1
-- drifted-claude.md --
# MY CUSTOM HEADER

<!-- BEGIN adr-sourced-constitution v1 (managed — do not edit by hand; `constitution init` updates it) -->
@constitution/HACKED.md
<!-- END adr-sourced-constitution v1 -->

Trailing user note.
