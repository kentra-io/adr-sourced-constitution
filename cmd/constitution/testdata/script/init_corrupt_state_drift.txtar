# The .state self-heal must NOT become a way to silently clobber a hand-edited
# managed file. With a corrupt .state degraded to empty AND a drifted CLAUDE.md,
# a non-interactive re-init without --force still refuses (drift detection is
# content-hash based, so an empty state still catches a drifted interior). The
# user's edits are preserved.

env CONSTITUTION_TODAY=2026-07-02

exec constitution init --target claude

# drift the managed block AND poison the drift bookkeeping
cp drifted-claude.md CLAUDE.md
cp corrupt.state constitution/.state

! exec constitution init --target claude
stderr 'empty drift state'
stderr 'refusing to overwrite'
grep 'HACKED' CLAUDE.md

-- corrupt.state --
schemaVersion: [1
-- drifted-claude.md --
# MY CUSTOM HEADER

<!-- BEGIN adr-sourced-constitution v1 (managed — do not edit by hand; `constitution init` updates it) -->
@constitution/HACKED.md
<!-- END adr-sourced-constitution v1 -->

Trailing user note.
