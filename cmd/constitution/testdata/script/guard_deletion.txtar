# Planted mutation: an accepted ADR deleted from the append-only log.
# git diff (vs HEAD) reports it as deleted; the manifest also records a file
# no longer on disk. Both surface as file_deleted. Exit 1.

env CONSTITUTION_TODAY=2026-07-01
env GIT_AUTHOR_NAME=guard-test
env GIT_AUTHOR_EMAIL=guard-test@example.com
env GIT_COMMITTER_NAME=guard-test
env GIT_COMMITTER_EMAIL=guard-test@example.com
env GIT_CONFIG_NOSYSTEM=1

exec git init -q -b main
exec constitution adr new --title 'First rule' --category architecture --body-file body.md
exec git add -A
exec git commit -q -m init

rm constitution/adr/ADR-0001-first-rule.md

exitcode 1 constitution guard
stdout '\[file_deleted\] ADR-0001'

-- constitution.yml --
schemaVersion: 1
consent:
  policy: off
sourceTracking:
  type: none
categories:
  - architecture

-- body.md --
## Context and Problem Statement

We need a governing rule.

## Considered Options

- Do nothing
- Adopt the rule

## Decision Outcome

Adopt the rule.
