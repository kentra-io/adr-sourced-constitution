# Planted mutation: an out-of-band edit to an accepted ADR's body.
# git mode (vs HEAD) sees the working-tree diff -> body_changed; the manifest,
# not regenerated, still holds the old hash -> manifest_mismatch. Exit 1.

env CONSTITUTION_TODAY=2026-07-01
env GIT_AUTHOR_NAME=guard-test
env GIT_AUTHOR_EMAIL=guard-test@example.com
env GIT_COMMITTER_NAME=guard-test
env GIT_COMMITTER_EMAIL=guard-test@example.com
env GIT_CONFIG_NOSYSTEM=1

exec git init -q -b main
exec constitution adr new --title 'First rule' --body-file body.md
exec git add -A
exec git commit -q -m init

# tamper the body out-of-band (bypassing the CLI)
cp tampered.md constitution/adr/ADR-0001-first-rule.md

exitcode 1 constitution guard
stdout '\[body_changed\] ADR-0001'
stdout '\[manifest_mismatch\] ADR-0001'

# JSON payload carries both kinds and clean=false
exitcode 1 constitution guard --format json
stdout '"kind": "body_changed"'
stdout '"kind": "manifest_mismatch"'
stdout '"clean": false'

-- constitution.yml --
schemaVersion: 1
consent:
  policy: off
sourceTracking:
  type: none
categories:
  - architecture

-- body.md --
## Context and Problem Statement

We need a governing rule.

## Considered Options

- Do nothing
- Adopt the rule

## Decision Outcome

Adopt the rule.

-- tampered.md --
---
id: ADR-0001
title: First rule
category: architecture
date: 2026-07-01
status: accepted
---

## Context and Problem Statement

We need a governing rule.

## Considered Options

- Do nothing
- Adopt the rule

## Decision Outcome

Quietly reverse the rule.
