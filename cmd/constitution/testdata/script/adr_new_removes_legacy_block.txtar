# The legacy-block removal runs on every regen path, including the auto-regen
# a mutating verb triggers: `adr new` lands the ADR and removes the
# unedited always-loaded block from CLAUDE.md.

env CONSTITUTION_TODAY=2026-07-02

exec constitution init
cp legacy-claude.md CLAUDE.md

exec constitution adr new --title 'New rule' --body-file body.md --approve
stdout 'created .*ADR-0001-new-rule\.md'
stdout '^constitution: removed the always-loaded constitution block from CLAUDE.md$'
cmp CLAUDE.md want-claude.md

-- legacy-claude.md --
# Notes
<!-- BEGIN adr-sourced-constitution v1 (managed — do not edit by hand; `constitution init` updates it) -->
@constitution/constitution.md
<!-- END adr-sourced-constitution v1 -->
-- want-claude.md --
# Notes
-- body.md --
## Context and Problem Statement

x

## Considered Options

- a

## Decision Outcome

y
