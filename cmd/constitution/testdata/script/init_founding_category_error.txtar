# --founding-category must name a category in the configured vocabulary; an
# unknown one is a could-not-run error (exit 2) naming the bad value and the
# allowed set. Locks the error-message contract (implementation-plan §8).

env CONSTITUTION_TODAY=2026-07-02

exitcode 2 constitution init --principle P --founding-category bogus --category architecture --category process
stderr '--founding-category "bogus" is not in the configured vocabulary \[architecture, process\]'

# no founding ADR was seeded
! exists constitution/adr/ADR-0001-p.md
