# `constitution deviation validate` end-to-end (plan §2.9): the CLI-owned
# validator for deviation.json. Exercises exit 0 (valid), exit 1 (each invalid
# class), and exit 2 (could not run), plus the advisory stale-hash path.

env CONSTITUTION_TODAY=2026-07-01

# Build a live project: one ADR (ADR-0001) and a rendered constitution.md.
exec constitution adr new --title 'First rule' --category architecture --body-file body.md
exists constitution/constitution.md

# --- valid: matching hash, real adrId, tallying summary -> exit 0, no advisory
injecthash valid.json
exitcode 0 constitution deviation validate valid.json
stdout 'valid.json is valid'
! stderr 'mismatch'

# --- valid but stale hash -> exit 0 with a HIGH advisory on stderr
exitcode 0 constitution deviation validate stale.json
stderr 'constitutionHash mismatch \[HIGH'
stderr 'expected sha256:'
stdout 'stale.json is valid'

# --- invalid: missing adrId (schema) -> exit 1
injecthash missing_adr.json
exitcode 1 constitution deviation validate missing_adr.json
stderr 'missing property .adrId.'

# --- invalid: bad severity enum (schema) -> exit 1
injecthash bad_severity.json
exitcode 1 constitution deviation validate bad_severity.json
stderr 'at /deviations/0/severity: value must be one of .CRITICAL., .HIGH., .MEDIUM., .LOW.'

# --- invalid: unknown adrId (semantic) -> exit 1
injecthash unknown_adr.json
exitcode 1 constitution deviation validate unknown_adr.json
stderr 'adrId "ADR-9999" does not match any ADR in the log'

# --- invalid: summary counts do not tally (semantic) -> exit 1
injecthash bad_counts.json
exitcode 1 constitution deviation validate bad_counts.json
stderr 'summary counts do not match the deviations'

# --- could not run: file does not exist -> exit 2
exitcode 2 constitution deviation validate nope.json
stderr 'reading nope.json'

# --- could not run: not a constitution project root -> exit 2
mkdir empty
cd empty
exitcode 2 constitution deviation validate ../valid.json
stderr 'no constitution.yml'
cd ..

-- constitution.yml --
schemaVersion: 1
consent:
  policy: off
sourceTracking:
  type: none
categories:
  - architecture

-- body.md --
## Context and Problem Statement

We need a governing rule.

## Considered Options

- Do nothing
- Adopt the rule

## Decision Outcome

Adopt the rule.

-- valid.json --
{"generatedAt":"2026-07-03T00:00:00Z","constitutionHash":"__HASH__","plan":"plan.md",
 "deviations":[{"id":"D-001","adrId":"ADR-0001","severity":"HIGH","rule":"First rule",
   "location":{"file":"plan.md","lines":"1-10"},"summary":"conflicts with the rule",
   "recommendation":"conform"}],
 "summary":{"critical":0,"high":1,"medium":0,"low":0}}

-- stale.json --
{"generatedAt":"2026-07-03T00:00:00Z","constitutionHash":"sha256:deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef","plan":"plan.md",
 "deviations":[],"summary":{"critical":0,"high":0,"medium":0,"low":0}}

-- missing_adr.json --
{"generatedAt":"x","constitutionHash":"__HASH__","plan":"p",
 "deviations":[{"id":"D-001","severity":"HIGH","rule":"r","location":{"file":"p"},
   "summary":"s","recommendation":"conform"}],
 "summary":{"critical":0,"high":1,"medium":0,"low":0}}

-- bad_severity.json --
{"generatedAt":"x","constitutionHash":"__HASH__","plan":"p",
 "deviations":[{"id":"D-001","adrId":"ADR-0001","severity":"BLOCKER","rule":"r",
   "location":{"file":"p"},"summary":"s","recommendation":"conform"}],
 "summary":{"critical":0,"high":0,"medium":0,"low":0}}

-- unknown_adr.json --
{"generatedAt":"x","constitutionHash":"__HASH__","plan":"p",
 "deviations":[{"id":"D-001","adrId":"ADR-9999","severity":"LOW","rule":"r",
   "location":{"file":"p"},"summary":"s","recommendation":"amend"}],
 "summary":{"critical":0,"high":0,"medium":0,"low":1}}

-- bad_counts.json --
{"generatedAt":"x","constitutionHash":"__HASH__","plan":"p",
 "deviations":[{"id":"D-001","adrId":"ADR-0001","severity":"HIGH","rule":"r",
   "location":{"file":"p"},"summary":"s","recommendation":"conform"}],
 "summary":{"critical":5,"high":0,"medium":0,"low":0}}
