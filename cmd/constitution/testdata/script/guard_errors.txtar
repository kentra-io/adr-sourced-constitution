# Exit-code 2 ("guard could not run"), told apart from 1 ("violations"):
#   (a) git mode explicitly requested (--base) outside any git repo;
#   (b) manifest-only mode (--no-git) with ADRs present but no manifest;
#   (c) run from a directory that is not a constitution project root at all.
# In every case stdout stays empty (a JSON consumer sees a clean pipe, not a
# malformed payload) and the reason goes to stderr.

env GIT_CONFIG_NOSYSTEM=1

# (a) a real project (has constitution.yml) that is NOT a git repo, with git
# mode explicitly requested -> exit 2, empty stdout.
cd norepo
exitcode 2 constitution guard --base HEAD
! stdout .
stderr 'not a usable git repository'

# a BARE guard in that same project degrades to manifest-only and is
# vacuously clean (a valid project, no ADRs, no manifest) -> exit 0.
exitcode 0 constitution guard
stdout 'manifest-only'

# (b) --no-git with an ADR present but no manifest -> exit 2, empty stdout.
cd ../missing
exitcode 2 constitution guard --no-git
! stdout .
stderr 'not found \(run .constitution regen. to create it\)'

# (c) a directory with no constitution.yml is not a project root: guard must
# not scan zero ADRs and report a false "clean" -> exit 2, empty stdout.
cd ../notaproject
exitcode 2 constitution guard
! stdout .
stderr 'no constitution.yml'

# even a subdirectory of a real project is rejected: v1 requires guard to run
# from the root itself, it never walks upward to find constitution.yml.
cd ../missing/constitution
exitcode 2 constitution guard
! stdout .
stderr 'no constitution.yml'

