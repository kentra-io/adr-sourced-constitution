# A pre-existing CLAUDE.md with no managed block is left byte-identical by
# init (0.4.0 writes no pointer block), and no AGENTS.md is created.

env CONSTITUTION_TODAY=2026-07-02

cp CLAUDE.md want-claude.md
exec constitution init
! stdout 'removed'
cmp CLAUDE.md want-claude.md
! exists AGENTS.md

-- CLAUDE.md --
# My project

Existing user guidance.
