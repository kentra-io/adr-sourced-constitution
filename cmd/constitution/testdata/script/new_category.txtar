# Category governance (plan §2.5): an unknown category hard-errors unless
# --new-category is passed, which appends it to the config and proceeds.

env CONSTITUTION_TODAY=2026-07-02

# --- unknown category without the flag: refuse, nothing written ---
! exec constitution adr new --title 'A test rule' --category testing --body-file body.md
stderr 'unknown category "testing"'
stderr 'pass --new-category to introduce it'
! exists constitution/adr/ADR-0001-a-test-rule.md

# --- with --new-category: proceeds and the vocabulary now includes it ---
exec constitution adr new --title 'A test rule' --category testing --body-file body.md --new-category
stdout 'created .*ADR-0001-a-test-rule\.md'
grep 'category: testing' constitution/adr/ADR-0001-a-test-rule.md

# The category is now known, so a second testing ADR needs no flag.
exec constitution adr new --title 'Another test rule' --category testing --body-file body.md
stdout 'created .*ADR-0002-another-test-rule\.md'

-- constitution.yml --
schemaVersion: 1
consent:
  policy: off
sourceTracking:
  type: none
categories:
  - architecture

-- body.md --
## Context and Problem Statement

x

## Considered Options

- a

## Decision Outcome

y
