# regen refreshes fanned-out skills in warn-don't-block mode (plan §4): a
# skill file that drifted from what init last wrote produces a warning on
# stderr and is left untouched — drift in a user file must never block regen
# (nor the mutating verbs that auto-run it). regen still exits 0.

env CONSTITUTION_TODAY=2026-07-02

exec constitution init

# drift a fanned-out skill
cp drifted-skill.md .claude/skills/adr-draft/SKILL.md

exec constitution regen
stdout 'wrote .*constitution\.md'
stderr 'drifted from what'
stderr 'leaving it untouched'

# file untouched by regen
cmp .claude/skills/adr-draft/SKILL.md drifted-skill.md

-- drifted-skill.md --
HACKED
