# regen refreshes managed blocks in warn-don't-block mode (plan §4): a block
# that drifted from what init last wrote produces a warning on stderr and is
# left untouched — drift in a user file must never block regen (nor the
# mutating verbs that auto-run it). regen still exits 0.

env CONSTITUTION_TODAY=2026-07-02

exec constitution init --principle 'P1' --target claude

# drift the managed block interior
cp drifted-claude.md CLAUDE.md

exec constitution regen
stdout 'wrote .*constitution\.md'
stderr 'drifted from what'
stderr 'leaving it untouched'

# file untouched by regen
grep 'HACKED' CLAUDE.md

-- drifted-claude.md --
<!-- BEGIN adr-sourced-constitution v1 (managed — do not edit by hand; `constitution init` updates it) -->
@constitution/HACKED.md
<!-- END adr-sourced-constitution v1 -->
