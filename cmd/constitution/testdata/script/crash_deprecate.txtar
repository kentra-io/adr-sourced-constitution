# Crash-injection DoD, deprecate's single seam: kill the real process AFTER
# the status patch is written but BEFORE the regen. The log is fully
# transitioned (status: deprecated on disk); only the projection and
# manifest are stale. Recovery is a plain regen, which parses the log,
# drops the deprecated ADR from the projection, and converges.

env CONSTITUTION_TODAY=2026-07-02
env CONSTITUTION_CRASH_AFTER=after-old-patch

# The process is killed mid-sequence (exit 137, non-zero); the status flip
# itself already landed atomically.
! exec constitution deprecate ADR-0001
grep 'status: deprecated' constitution/adr/ADR-0001-original.md

# The stale projection still shows the rule — proof the crash landed between
# the patch and the regen.
grep 'ADR-0001' constitution/constitution.md

# Recovery: regen converges (deprecated ADR leaves the projection) and is
# idempotent.
env CONSTITUTION_CRASH_AFTER=
exec constitution regen
stdout 'wrote'
! grep 'ADR-0001' constitution/constitution.md
cp constitution/constitution.md first.md
exec constitution regen
cmp constitution/constitution.md first.md

-- constitution.yml --
schemaVersion: 1
